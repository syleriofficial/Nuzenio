{
  "name": "nuzenio",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "lint:web": "npm --workspace apps/web run lint",
    "format:web": "npm --workspace apps/web run format",
    "test:web": "npm --workspace apps/web run test",
    "build:web": "npm --workspace apps/web run build",
    "test:api": "apps/api/.venv/bin/pytest apps/api/tests",
    "lint:api": "apps/api/.venv/bin/ruff check apps/api",
    "format:api": "apps/api/.venv/bin/ruff format apps/api"
  },
  "engines": { "node": ">=22.13.0" }
}
