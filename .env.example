# Web
NUZENIO_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8000
NUZENIO_ENABLE_DEMO_FALLBACK=false
# Web-only, development-server-only fictional source-card showcase. No fetch.
# Also requires exact development/test environment, demo=true, kill switch=true.
NUZENIO_FREE_SOURCE_PREVIEW=false
# Exact address opened by readers; no trailing slash. Export into the web process
# (or apps/web/.env.local). Missing/mismatched value disables report submission.
NUZENIO_REPORT_WEB_ORIGIN=http://localhost:3000

# API (pydantic-settings prefix: NUZENIO_)
# Required explicitly; missing and noncanonical values fail before API/worker startup.
NUZENIO_ENVIRONMENT=development
NUZENIO_DEMO_MODE=true
# Opt-in offline fixture article inbox. Forbidden in production; requires demo
# mode and NUZENIO_FEED_KILL_SWITCH=true. Does not enable feed polling.
NUZENIO_DRAFT_INBOX_ENABLED=false
NUZENIO_DATABASE_URL=postgresql+psycopg://nuzenio_runtime:local-runtime-only-password@localhost:5432/nuzenio
NUZENIO_TEST_DATABASE_URL=postgresql+psycopg://nuzenio:nuzenio@localhost:5432/nuzenio_test
NUZENIO_REDIS_URL=redis://localhost:6379/0
NUZENIO_CORS_ORIGINS=["http://localhost:3000"]
NUZENIO_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
NUZENIO_MAX_PAGE_SIZE=50
NUZENIO_SQL_ECHO=false
NUZENIO_LOG_LEVEL=INFO
NUZENIO_LOG_JSON=true
# Client IP logging is off by default; enable only with a documented retention/legal basis.
NUZENIO_LOG_CLIENT_IP=false
# Required and 32+ characters in production. Empty is permitted for local-only metrics.
NUZENIO_METRICS_TOKEN=
NUZENIO_READINESS_TIMEOUT_SECONDS=2
# Fixed-window report admission, independent of staff login admission.
NUZENIO_REPORT_KEY_PREFIX=nuzenio:reports:v1
NUZENIO_REPORT_GLOBAL_LIMIT=120
NUZENIO_REPORT_PEER_LIMIT=30
NUZENIO_REPORT_WINDOW_SECONDS=60
NUZENIO_SESSION_COOKIE_NAME=nuzenio_staff_session
NUZENIO_CSRF_COOKIE_NAME=nuzenio_staff_csrf
NUZENIO_SESSION_TTL_MINUTES=480
NUZENIO_COOKIE_SECURE=false
# Generate a unique value for any non-local environment; never commit it.
NUZENIO_SESSION_HASH_PEPPER=development-only-change-me
# Required by staff bootstrap only when NUZENIO_ENVIRONMENT=production.
NUZENIO_BOOTSTRAP_TOKEN=
NUZENIO_LOGIN_ATTEMPT_LIMIT=5
NUZENIO_LOGIN_LOCKOUT_MINUTES=15
# Legacy lockout setting is no longer used. Fixed windows do not extend on denial.
NUZENIO_LOGIN_GLOBAL_LIMIT=120
NUZENIO_LOGIN_IP_LIMIT=30
NUZENIO_LOGIN_WINDOW_SECONDS=60
NUZENIO_LOGIN_CONCURRENCY=4
# Hard subprocess work deadline (0.1–10 seconds), not an expiring capacity lease.
NUZENIO_LOGIN_VERIFIER_TIMEOUT_SECONDS=3
# Optional: private LOCAL filesystem directory shared by all API processes on a host.
# Default is the OS temporary directory / nuzenio-password-<uid>.
# Never remove/replace lock files or change concurrency while a verifier may exist.
# NUZENIO_LOGIN_LOCK_DIRECTORY=/run/nuzenio-password
NUZENIO_LOGIN_KEY_PREFIX=nuzenio:auth:v2
NUZENIO_TRUSTED_PROXY_CIDRS=[]
NUZENIO_FEED_USER_AGENT=NuzenioFeedFetcher/0.4 (+https://nuzenio.example/feeds)
NUZENIO_FEED_TIMEOUT_SECONDS=10
NUZENIO_FEED_MAX_BYTES=2000000
NUZENIO_FEED_REDIRECT_LIMIT=3
NUZENIO_FEED_HTTPS_REQUIRED=true
# Compose defaults this to true so fictional .example seed feeds are never fetched.
NUZENIO_FEED_KILL_SWITCH=true
NUZENIO_RUNTIME_DATABASE_ROLE=nuzenio_runtime
NUZENIO_WORKER_HEALTH_HOST=0.0.0.0
NUZENIO_WORKER_HEALTH_PORT=8001
NUZENIO_WORKER_POLL_SECONDS=2
NUZENIO_WORKER_STALE_AFTER_SECONDS=30

# Docker Compose only — local development defaults, never production credentials
POSTGRES_DB=nuzenio
POSTGRES_USER=nuzenio
POSTGRES_PASSWORD=nuzenio
# Explicit local-only credential for the separate unprivileged runtime role.
NUZENIO_RUNTIME_PASSWORD=local-runtime-only-password
# Explicit local-only credential for the restricted audit reader.
NUZENIO_AUDIT_ROLE=nuzenio_audit_reader
NUZENIO_AUDIT_PASSWORD=local-audit-only-password
# Production provisioning requires a separately injected migration-owner URL.
NUZENIO_MIGRATION_DATABASE_URL=
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
