# Web
NUZENIO_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8000
NUZENIO_ENABLE_DEMO_FALLBACK=false

# API (pydantic-settings prefix: NUZENIO_)
NUZENIO_ENVIRONMENT=development
NUZENIO_DEMO_MODE=true
NUZENIO_DATABASE_URL=postgresql+psycopg://nuzenio_runtime:local-runtime-only-password@localhost:5432/nuzenio
NUZENIO_TEST_DATABASE_URL=postgresql+psycopg://nuzenio:nuzenio@localhost:5432/nuzenio_test
NUZENIO_REDIS_URL=redis://localhost:6379/0
NUZENIO_CORS_ORIGINS=["http://localhost:3000"]
NUZENIO_MAX_PAGE_SIZE=50
NUZENIO_SQL_ECHO=false
NUZENIO_SESSION_COOKIE_NAME=nuzenio_staff_session
NUZENIO_CSRF_COOKIE_NAME=nuzenio_staff_csrf
NUZENIO_SESSION_TTL_MINUTES=480
NUZENIO_COOKIE_SECURE=false
# Generate a unique value for any non-local environment; never commit it.
NUZENIO_SESSION_HASH_PEPPER=development-only-change-me
# Required by staff bootstrap only when NUZENIO_ENVIRONMENT=production.
NUZENIO_BOOTSTRAP_TOKEN=
NUZENIO_LOGIN_ATTEMPT_LIMIT=5
NUZENIO_LOGIN_LOCKOUT_MINUTES=15
# Legacy lockout setting is no longer used. Fixed windows do not extend on denial.
NUZENIO_LOGIN_GLOBAL_LIMIT=120
NUZENIO_LOGIN_IP_LIMIT=30
NUZENIO_LOGIN_WINDOW_SECONDS=60
NUZENIO_LOGIN_CONCURRENCY=4
NUZENIO_LOGIN_KEY_PREFIX=nuzenio:auth:v2
NUZENIO_TRUSTED_PROXY_CIDRS=[]
NUZENIO_FEED_USER_AGENT=NuzenioFeedFetcher/0.3 (+https://nuzenio.example/feeds)
NUZENIO_FEED_TIMEOUT_SECONDS=10
NUZENIO_FEED_MAX_BYTES=2000000
NUZENIO_FEED_REDIRECT_LIMIT=3
NUZENIO_FEED_HTTPS_REQUIRED=true
# Compose defaults this to true so fictional .example seed feeds are never fetched.
NUZENIO_FEED_KILL_SWITCH=true

# Docker Compose only — local development defaults, never production credentials
POSTGRES_DB=nuzenio
POSTGRES_USER=nuzenio
POSTGRES_PASSWORD=nuzenio
# Explicit local-only credential for the separate unprivileged runtime role.
NUZENIO_RUNTIME_PASSWORD=local-runtime-only-password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
