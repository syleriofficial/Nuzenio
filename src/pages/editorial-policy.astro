---
import BaseLayout from "../layouts/BaseLayout.astro";
const principles = [
  { title: "तथ्य पहले", text: "समाचार में किए गए महत्त्वपूर्ण दावों के मूल स्रोतों की पुष्टि करने की कोशिश की जाएगी। अपुष्ट दावों को स्पष्ट रूप से अपुष्ट बताया जाएगा।" },
  { title: "मानव संपादकीय स्वीकृति", text: "हर लेख और Web Story समीक्षा और अनुमोदन के बाद ही प्रकाशित होगी। स्वचालित न्यूज़ प्रकाशन या बिना समीक्षा की AI पोस्टिंग नहीं होगी।" },
  { title: "राय और खबर में अंतर", text: "समाचार, विश्लेषण, समीक्षा, राय और विज्ञापन को उपयुक्त लेबल दिए जाएँगे ताकि पाठक उनके बीच अंतर समझ सकें।" },
  { title: "चित्रों के अधिकार", text: "फोटो, ग्राफ़िक्स और वीडियो का इस्तेमाल उचित अधिकार या अनुमति के आधार पर किया जाएगा। सांकेतिक तस्वीरों को स्पष्ट चिह्नित किया जाएगा।" },
  { title: "त्रुटि सुधार", text: "किसी महत्वपूर्ण तथ्य में गलती मिलने पर सुधार किया जाएगा और जहाँ उपयुक्त हो वहाँ परिवर्तन पारदर्शी रूप से दर्शाया जाएगा।" },
  { title: "कोई काल्पनिक रिपोर्टिंग नहीं", text: "नमूना सामग्री को वास्तविक समाचार बताकर प्रकाशित नहीं किया जाएगा। स्रोत, तारीख, उद्धरण या घटनास्थल से जुड़ी बातें मनगढ़ंत नहीं बनाई जाएँगी।" }
];
---
<BaseLayout title="संपादकीय नीति" description="तथ्य-जाँच, मानव समीक्षा, सुधार और सामग्री अधिकारों को लेकर Nuzenio के सिद्धांत।">
  <div class="container basic-page">
    <nav class="breadcrumb" aria-label="ब्रेडक्रंब"><a href="/">होम</a><span>/</span><span>संपादकीय नीति</span></nav>
    <p class="eyebrow"><span class="red-mark"></span> EDITORIAL STANDARDS</p><h1>विश्वसनीयता कोई विकल्प नहीं<span class="title-red-dot">.</span></h1>
    <p class="basic-lead">हमारी दिशा: खबरों में सटीकता, स्पष्टता और जवाबदेही। ये इस विकासाधीन वेबसाइट के लिए प्रस्तावित संपादकीय मानक हैं।</p>
    <div class="policy-list">{principles.map((principle,index) => <section class="policy-item"><span>0{index+1}</span><div><h2>{principle.title}</h2><p>{principle.text}</p></div></section>)}</div>
  </div>
</BaseLayout>
