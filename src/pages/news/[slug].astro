---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articles, getCategory, site, type Article } from "../../data/editorial";
import { getApprovedNews, formatHindiDate } from "../../lib/publications";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const approved = await getApprovedNews();
  const paths = approved.map((entry) => ({ params: { slug: entry.id }, props: { published: entry } }));
  const publishedSlugs = new Set(approved.map((entry) => entry.id));
  const demos = site.preview
    ? articles.filter((item) => !publishedSlugs.has(item.slug)).map((article) => ({ params: { slug: article.slug }, props: { article } }))
    : [];
  return [...paths, ...demos];
}

const { published, article } = Astro.props as {
  published?: CollectionEntry<"news">;
  article?: Article;
};
const category = getCategory(published?.data.category ?? article?.category ?? "");
const related = article && site.preview ? articles.filter((item) => item.slug !== article.slug && item.category === article.category).slice(0,2) : [];
const rendered = published ? await render(published) : null;
const Content = rendered?.Content;
---
{published ? (
  <BaseLayout title={published.data.title} description={published.data.description} image={published.data.image ?? "/images/city.svg"} type="article">
    <div class="container article-page">
      <nav aria-label="ब्रेडक्रंब" class="breadcrumb"><a href="/">होम</a><span aria-hidden="true">/</span><a href={"/category/" + published.data.category + "/"}>{category?.name}</a><span aria-hidden="true">/</span><span>समाचार</span></nav>
      <div class="article-header">
        <p class="eyebrow"><span class="red-mark"></span> {category?.name} <span class="eyebrow-divider">/</span> संपादकीय स्वीकृत</p>
        <h1>{published.data.title}</h1>
        <p class="article-standfirst">{published.data.description}</p>
        <div class="byline-row"><span class="author-avatar">N.</span><div><strong>{published.data.author}</strong><small><time datetime={published.data.publishedAt?.toISOString()}>{published.data.publishedAt && formatHindiDate(published.data.publishedAt)}</time></small></div></div>
      </div>
      {published.data.image && <figure class="article-hero-figure"><img src={published.data.image} alt={published.data.imageAlt ?? ""} /><figcaption>{published.data.imageCredit || "संपादकीय चित्र"} · {published.data.imageRights}</figcaption></figure>}
      <div class="article-reading-grid">
        <div class="article-tools"><span>इस पेज पर</span><a href="#article-body">लेख</a><a href="#sources">स्रोत</a><a href="#editorial-note">संपादकीय नोट</a></div>
        <article class="article-body" id="article-body">
          {Content && <Content />}
          <section id="sources" class="article-note">
            <h2>स्रोत और संदर्भ</h2>
            <ul>
              {published.data.sourceUrls.map((source, i) =>
                <li><a href={source} rel="noopener noreferrer nofollow" target="_blank">स्रोत {i + 1}: {new URL(source).hostname} ↗</a></li>
              )}
            </ul>
          </section>
          <div id="editorial-note" class="article-note"><h3>संपादकीय जानकारी</h3><p>मानव समीक्षा और स्वीकृति के बाद प्रकाशित। अंतिम स्वीकृति: {published.data.approvedBy}। किसी तथ्य में त्रुटि हो तो उसे सुधारने की प्रक्रिया संपादकीय नीति में वर्णित है।</p><a href="/editorial-policy/">हमारी नीति ↗</a></div>
        </article>
        <aside class="article-aside"><p class="aside-kicker">NUZENIO</p><h3>सिर्फ खबर नहीं,<br />उसका संदर्भ भी।</h3><p>मूल स्रोतों और स्पष्ट भाषा के साथ।</p></aside>
      </div>
    </div>
  </BaseLayout>
) : article && site.preview ? (
  <BaseLayout title={article.title} description={article.excerpt} image={article.image} type="article">
    <div class="container article-page">
      <nav aria-label="ब्रेडक्रंब" class="breadcrumb"><a href="/">होम</a><span aria-hidden="true">/</span><a href={"/category/" + article.category + "/"}>{category?.name}</a><span aria-hidden="true">/</span><span>नमूना लेख</span></nav>
      <div class="article-header">
        <p class="eyebrow"><span class="red-mark"></span> {category?.name} <span class="eyebrow-divider">/</span> {article.label}</p>
        <h1>{article.title}</h1>
        <p class="article-standfirst">{article.excerpt}</p>
        <div class="byline-row"><span class="author-avatar">N.</span><div><strong>Nuzenio — डेमो डेस्क</strong><small>डिज़ाइन नमूना · {article.minutes} मिनट पढ़ें</small></div></div>
      </div>
      <figure class="article-hero-figure"><img src={article.image} alt={article.imageAlt} /><figcaption>मौलिक सांकेतिक चित्र · यह वास्तविक घटनास्थल की तस्वीर नहीं है।</figcaption></figure>
      <div class="article-reading-grid">
        <div class="article-tools"><span>इस पेज पर</span><a href="#article-body">लेख</a><a href="#important-points">मुख्य बातें</a><a href="#editorial-note">संपादकीय नोट</a></div>
        <article id="article-body" class="article-body">
          <div class="article-disclaimer"><strong>केवल डिज़ाइन प्रीव्यू</strong><p>यह उदाहरण लेख है, प्रकाशित या सत्यापित ताज़ा समाचार नहीं। इसे वास्तविक रिपोर्ट की तरह साझा न करें।</p></div>
          {article.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <h2 id="important-points">ध्यान रखने वाली बातें</h2>
          <ul>{article.points.map((point) => <li>{point}</li>)}</ul>
          <div id="editorial-note" class="article-note"><h3>हमारी संपादकीय प्रक्रिया</h3><p>वास्तविक खबरों के लिए मूल स्रोत, तथ्य-जाँच, उचित चित्र-अनुमति और मानव संपादकीय स्वीकृति आवश्यक होगी। इस डेमो लेख के लिए कोई घटनास्थल या अज्ञात स्रोत दावा नहीं किया गया है।</p><a href="/editorial-policy/">संपादकीय नीति ↗</a></div>
        </article>
        <aside class="article-aside"><p class="aside-kicker">NUZENIO</p><h3>समझना भी ज़रूरी है।</h3><p>सिर्फ क्या हुआ नहीं, क्यों और कैसे—इसका संदर्भ भी।</p></aside>
      </div>
      {related.length > 0 && <section class="section-block related-section"><div class="section-heading"><div><span class="heading-line"></span><h2>इससे जुड़ी कहानियाँ</h2></div></div><div class="three-grid">{related.map((item) => <a class="article-card" href={"/news/" + item.slug + "/"}><div class="article-image"><img src={item.image} alt={item.imageAlt} /></div><div class="article-copy"><h3>{item.title}</h3></div></a>)}</div></section>}
    </div>
  </BaseLayout>
) : null}
