---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WebStoryCard from "../../components/WebStoryCard.astro";
import PublishedStoryCard from "../../components/PublishedStoryCard.astro";
import { getApprovedStories } from "../../lib/publications";
import { webStories, site } from "../../data/editorial";
const published = await getApprovedStories();
---
<BaseLayout title="वेब स्टोरीज़" description="Nuzenio की छोटी, विज़ुअल हिंदी कहानियाँ — अभी डेमो प्रीव्यू।">
  <div class="container">
    <nav aria-label="ब्रेडक्रंब" class="breadcrumb"><a href="/">होम</a><span>/</span><span>वेब स्टोरीज़</span></nav>
    <section class="category-hero stories-page-hero">
      <p class="eyebrow"><span class="red-mark"></span> VISUAL JOURNALISM</p>
      <h1>वेब स्टोरीज़<span class="title-red-dot">.</span></h1>
      <p>जटिल विषयों की साफ़, छोटी और देखने लायक कहानी।</p>
    </section>
    <section class="section-block">
      <div class="section-heading"><div><span class="heading-line"></span><h2>सभी स्टोरीज़</h2><span class="heading-label">{published.length} स्वीकृत स्टोरीज़</span></div></div>
      <div class="stories-index-grid">{published.map((entry) => <PublishedStoryCard entry={entry} />)}{site.preview && webStories.map((story) => <WebStoryCard story={story} />)}</div>
      <p class="index-note"><strong>महत्त्वपूर्ण:</strong> ये मोबाइल-फ्रेंडली HTML Web Stories हैं; AMP तकनीकी सत्यापन अलग अगले चरण में होगा।{site.preview && " डेमो स्टोरीज़ वास्तविक समाचार नहीं हैं।"}</p>
    </section>
  </div>
</BaseLayout>
