---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import WebStoryCard from "../components/WebStoryCard.astro";
import PublishedCard from "../components/PublishedCard.astro";
import PublishedStoryCard from "../components/PublishedStoryCard.astro";
import { getApprovedNews, getApprovedStories } from "../lib/publications";
import { articles, categories, webStories, site } from "../data/editorial";
const approvedNews = await getApprovedNews();
const approvedStories = await getApprovedStories();
const lead = articles[0];
const supporting = articles.slice(1,3);
const newest = articles.slice(3);
---
<BaseLayout>
  <div class="container">
    <section class="home-intro">
      <div>
        <p class="eyebrow"><span class="red-mark"></span> NUZENIO · हिंदी न्यूज़</p>
        <h1>खबर से आगे,<br /><em>पूरी तस्वीर।</em></h1>
        <p class="home-intro-dek">देश-दुनिया की बड़ी बातों को सरल भाषा, ठोस संदर्भ और साफ़ नज़रिए से समझिए।</p>
      </div>
      <div class="intro-side">
        <div class="intro-side-line"></div>
        <span class="intro-number">01 / 03</span>
        <p>सटीक जानकारी।<br />विचारपूर्ण प्रस्तुति।<br />पाठक का सम्मान।</p>
        <a href="/editorial-policy/">हमारे संपादकीय सिद्धांत <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    {approvedNews.length > 0 && <section class="section-block latest-news" aria-labelledby="approved-heading"><div class="section-heading"><div><span class="heading-line"></span><h2 id="approved-heading">ताज़ा प्रकाशित</h2><span class="heading-label">संपादकीय रूप से स्वीकृत लेख</span></div><a href="/search/" class="text-link">सभी लेख ↗</a></div><div class="three-grid">{approvedNews.slice(0,6).map((entry) => <PublishedCard entry={entry} />)}</div></section>}
    {site.preview && <>
    <section class="section-block hero-news" aria-labelledby="top-headlines">
      <div class="section-heading">
        <div><span class="heading-line"></span><h2 id="top-headlines">मुख्य कहानियाँ</h2><span class="heading-label">डिज़ाइन के लिए नमूना लेख</span></div>
        <a href="/search/" class="text-link">सभी लेख <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-grid">
        <div class="hero-lead"><ArticleCard article={lead} featured /></div>
        <div class="hero-side">{supporting.map((article) => <ArticleCard article={article} compact />)}</div>
      </div>
    </section>

    <section class="section-block latest-news" aria-labelledby="latest-heading">
      <div class="section-heading">
        <div><span class="heading-line"></span><h2 id="latest-heading">और पढ़ें</h2><span class="heading-label">समझ, संदर्भ और विश्लेषण</span></div>
      </div>
      <div class="three-grid">{newest.map((article) => <ArticleCard article={article} />)}</div>
    </section>
    </>}
  </div>

  {(site.preview || approvedStories.length > 0) && <section class="stories-panel" aria-labelledby="stories-heading">
    <div class="container">
      <div class="section-heading section-heading-dark">
        <div><span class="heading-line"></span><h2 id="stories-heading">वेब स्टोरीज़</h2><span class="heading-label">तस्वीरों में, कम शब्दों में</span></div>
        <a href="/web-stories/" class="text-link">सभी स्टोरीज़ <span aria-hidden="true">↗</span></a>
      </div>
      <div class="stories-layout">
        <div class="stories-intro">
          <span class="stories-large-icon" aria-hidden="true">▣</span>
          <h3>हर कहानी का<br /><em>एक नया नज़रिया।</em></h3>
          <p>कुछ विषय कम शब्दों और असरदार विज़ुअल्स में बेहतर समझ आते हैं। यहाँ वही कोशिश है।</p>
          <a href="/web-stories/" class="stories-cta">स्टोरीज़ एक्सप्लोर करें <span aria-hidden="true">↗</span></a>
        </div>
        <div class="stories-cards">{approvedStories.map((entry) => <PublishedStoryCard entry={entry} />)}{site.preview && webStories.map((story) => <WebStoryCard story={story} />)}</div>
      </div>
    </div>
  </section>}

  <div class="container">
    <section class="section-block explore-section" aria-labelledby="explore-heading">
      <div class="section-heading">
        <div><span class="heading-line"></span><h2 id="explore-heading">अपनी रुचि से पढ़ें</h2><span class="heading-label">कवरेज की प्रमुख श्रेणियाँ</span></div>
      </div>
      <div class="category-grid">
        {categories.map((category, index) => <a href={"/category/" + category.slug + "/"} class="category-tile"><span class="category-index">0{index + 1}</span><div><h3>{category.name}</h3><p>{category.description}</p></div><span class="category-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </section>
    <section class="editorial-statement">
      <span class="statement-mark">“</span>
      <div><p class="eyebrow">NUZENIO की सोच</p><h2>सबसे पहले सही बात।<br /><em>उसके बाद सबसे तेज़।</em></h2><p>तथ्यों की पुष्टि, स्रोत का उचित उल्लेख और इंसानी संपादकीय स्वीकृति—इन्हीं सिद्धांतों के साथ Nuzenio आगे बढ़ेगा।</p></div>
      <a href="/editorial-policy/" class="statement-link">संपादकीय नीति पढ़ें ↗</a>
    </section>
  </div>
</BaseLayout>
